# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your frontend URLs)
CLIENT_URLS=http://localhost:5173

# ---- MongoDB Atlas ----
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Database Access -> add a user, Network Access -> allow your IP (or 0.0.0.0/0 for any),
# then Connect -> Drivers -> copy the connection string below.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/agro-site?retryWrites=true&w=majority

# ---- Auth ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account, created automatically the first time the server boots
# if no admin exists yet in the database. Change the password after first login.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-now
ADMIN_DEFAULT_EMAIL=admin@example.com

# Local demo login is available only without MongoDB and outside production.
# Set these in backend/.env; never commit real credentials.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=

# One-time MongoDB admin password reset; run `npm run reset-admin-password --prefix backend`
# after setting the target admin username and password in the server environment.
ADMIN_USERNAME_RESET=admin
ADMIN_PASSWORD_RESET=

# ---- Email (contact form -> your inbox) ----
# Works with Gmail (use an "App Password", not your normal password:
# https://myaccount.google.com/apppasswords) or any SMTP provider
# (Zoho, Outlook, SendGrid SMTP, Mailtrap for testing, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_RECEIVER_EMAIL=info@yourcompany.com
